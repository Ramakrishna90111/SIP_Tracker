create table sip_registration(
	sip_id varchar(10) primary key,
	investor_id varchar(10),
	fund_id varchar(10),
	sip_amount float,
	sip_date int,
	frequency varchar,
	start_date date,
	sip_status varchar,
	foreign key(investor_id)
	references investor(investor_id)
	on delete cascade,
	foreign key(fund_id)
	references mutual_fund(fund_id)
	on delete cascade
);

